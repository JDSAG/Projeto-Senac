{
  "expo": {
    "name": "cliente-expo",
    "slug": "cliente-expo",
    "scheme": "restaurantesenac",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Precisamos da câmera para escanear o QR Code da mesa."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#E6F4FE"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para escanear o QR Code."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      "expo-build-properties"
    ]
  }
}
